# Copiar este archivo como .env y completar con la URI de la base que se va a usar.
# Opción A (recomendada para revisar): una base propia (Atlas M0 gratis o MongoDB local)
#   MONGO_URI=mongodb://localhost:27017/
# Opción B: el clúster del grupo; la URI con usuario y contraseña se entrega por privado.
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/
DB_NAME=quicktrack_db
PORT=8000
