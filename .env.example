# Plantilla de variables de entorno — QuickTrack
# Copie este archivo a ".env" y complete con sus credenciales reales.
# NUNCA suba el archivo ".env" ni credenciales reales al repositorio Git.

MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=quicktrack_db
PORT=8000
