	partition rutas = m
		mode: import
		source =
				let
				    Origen = Python.Execute("""""""#(lf)Extracción de datos de MongoDB Atlas para Power BI (QuickTrack).#(lf)#(lf)Uso en Power BI Desktop:#(lf)  Obtener datos > Más... > Otras > Script de Python > pegar este archivo completo.#(lf)  Power BI crea una tabla por cada DataFrame: ordenes, clientes, rutas,#(lf)  seguimiento, eventos_seguimiento y valoraciones.#(lf)#(lf)Requisitos: el Python configurado en Power BI (Archivo > Opciones > Scripting de Python)#(lf)debe tener instalados pymongo, pandas, matplotlib y python-dotenv.#(lf)#(lf)También se puede ejecutar directo para probar: python powerbi/extraer_quicktrack.py#(lf)Plan B sin Python en Power BI: python powerbi/extraer_quicktrack.py --csv  (deja los CSV en powerbi/csv/)#(lf)""""""#(lf)import os#(lf)import sys#(lf)#(lf)import pandas as pd#(lf)import pymongo#(lf)from dotenv import load_dotenv#(lf)#(lf)# pandas 3 usa un tipo de texto nuevo por defecto; se vuelve al de pandas 2 para que Power BI lo lea sin problemas#(lf)pd.options.future.infer_string = False#(lf)#(lf)# Power BI ejecuta el script desde una carpeta temporal, por eso la ruta del proyecto va fija.#(lf)# Cada integrante debe cambiarla por la ubicación de su copia del repositorio.#(lf)RUTA_PROYECTO = r""" & RutaProyecto & """#(lf)#(lf)load_dotenv(os.path.join(RUTA_PROYECTO, "".env""))#(lf)#(lf)#(lf)def extraer_tablas():#(lf)    """"""Lee las 5 colecciones con agregaciones y las devuelve como DataFrames planos.""""""#(lf)    uri = os.getenv(""MONGO_URI"")#(lf)    if not uri:#(lf)        raise ValueError(""Error: no se encontró MONGO_URI en el archivo .env del proyecto"")#(lf)#(lf)    client = pymongo.MongoClient(uri, serverSelectionTimeoutMS=8000)#(lf)    db = client[os.getenv(""DB_NAME"", ""quicktrack_db"")]#(lf)    try:#(lf)        # Órdenes con el estado de su seguimiento, para medir la coherencia entre ambas colecciones#(lf)        ordenes = pd.DataFrame(db.ordenes_entrega.aggregate([#(lf)            {""$lookup"": {""from"": ""seguimiento"", ""localField"": ""_id"", ""foreignField"": ""orden_id"", ""as"": ""seg""}},#(lf)            {""$unwind"": {""path"": ""$seg"", ""preserveNullAndEmptyArrays"": True}},#(lf)            {""$project"": {#(lf)                ""_id"": 0, ""orden_id"": ""$_id"", ""cliente_num_id"": 1, ""ruta_id"": 1,#(lf)                ""fecha_envio"": 1, ""estado"": 1, ""medio_pago"": 1, ""total"": 1,#(lf)                ""estado_seguimiento"": ""$seg.estado_actual"",#(lf)                ""ultimo_evento"": {""$arrayElemAt"": [""$seg.historial.estado"", -1]},#(lf)            }},#(lf)        ]))#(lf)        ordenes[""fecha_envio""] = pd.to_datetime(ordenes[""fecha_envio""])#(lf)        ordenes[""estado_coherente""] = ordenes[""estado""] == ordenes[""estado_seguimiento""]#(lf)#(lf)        clientes = pd.DataFrame(db.clientes.find(#(lf)            {}, {""_id"": 0, ""cliente_num_id"": ""$_id"", ""nombre"": 1, ""pais"": 1, ""fecha_registro"": 1}))#(lf)        clientes[""fecha_registro""] = pd.to_datetime(clientes[""fecha_registro""])#(lf)#(lf)        rutas = pd.DataFrame(db.rutas.find(#(lf)            {}, {""_id"": 0, ""ruta_id"": ""$_id"", ""zona"": 1, ""ciudad_origen"": 1, ""ciudad_destino"": 1, ""distancia_km"": 1}))#(lf)#(lf)        seguimiento = pd.DataFrame(db.seguimiento.aggregate([#(lf)            {""$project"": {#(lf)                ""_id"": 0, ""orden_id"": 1, ""estado_actual"": 1,#(lf)                ""eventos"": {""$size"": ""$historial""},#(lf)                ""primer_evento"": {""$arrayElemAt"": [""$historial.fecha"", 0]},#(lf)                ""ultimo_evento"": {""$arrayElemAt"": [""$historial.estado"", -1]},#(lf)                ""fecha_ultimo_evento"": {""$arrayElemAt"": [""$historial.fecha"", -1]},#(lf)            }},#(lf)        ]))#(lf)        seguimiento[""primer_evento""] = pd.to_datetime(seguimiento[""primer_evento""])#(lf)        seguimiento[""fecha_ultimo_evento""] = pd.to_datetime(seguimiento[""fecha_ultimo_evento""])#(lf)#(lf)        # Historial embebido desplegado: una fila por evento#(lf)        eventos_seguimiento = pd.DataFrame(db.seguimiento.aggregate([#(lf)            {""$unwind"": {""path"": ""$historial"", ""includeArrayIndex"": ""paso""}},#(lf)            {""$project"": {""_id"": 0, ""orden_id"": 1, ""paso"": {""$add"": [""$paso"", 1]},#(lf)                          ""estado"": ""$historial.estado"", ""fecha"": ""$historial.fecha""}},#(lf)        ]))#(lf)        eventos_seguimiento[""fecha""] = pd.to_datetime(eventos_seguimiento[""fecha""])#(lf)#(lf)        # Tiempo de entrega: días entre el primer evento y el evento ""Entregado"" (vacío si no se entregó)#(lf)        entregas = eventos_seguimiento[eventos_seguimiento[""estado""] == ""Entregado""].groupby(""orden_id"")[""fecha""].min()#(lf)        seguimiento[""dias_entrega""] = (seguimiento[""orden_id""].map(entregas) - seguimiento[""primer_evento""]).dt.days#(lf)#(lf)        valoraciones = pd.DataFrame(db.valoraciones.find(#(lf)            {}, {""_id"": 0, ""orden_id"": 1, ""puntaje"": 1, ""comentario"": 1}))#(lf)        valoraciones[""critica""] = valoraciones[""puntaje""] <= 2#(lf)        valoraciones[""con_retraso""] = valoraciones[""comentario""] == ""Tuvo retraso""#(lf)    finally:#(lf)        client.close()#(lf)#(lf)    return ordenes, clientes, rutas, seguimiento, eventos_seguimiento, valoraciones#(lf)#(lf)#(lf)# Power BI toma como tabla cada DataFrame definido en este nivel#(lf)ordenes, clientes, rutas, seguimiento, eventos_seguimiento, valoraciones = extraer_tablas()#(lf)#(lf)if __name__ == ""__main__"":#(lf)    carpeta_csv = os.path.join(RUTA_PROYECTO, ""powerbi"", ""csv"")#(lf)    if ""--csv"" in sys.argv:#(lf)        os.makedirs(carpeta_csv, exist_ok=True)#(lf)    for nombre, df in [(""ordenes"", ordenes), (""clientes"", clientes), (""rutas"", rutas),#(lf)                       (""seguimiento"", seguimiento), (""eventos_seguimiento"", eventos_seguimiento),#(lf)                       (""valoraciones"", valoraciones)]:#(lf)        print(f"" {nombre}: {len(df)} filas | columnas: {', '.join(df.columns)}"")#(lf)        if ""--csv"" in sys.argv:#(lf)            # utf-8-sig para que Power BI y Excel lean bien los tildes#(lf)            df.to_csv(os.path.join(carpeta_csv, f""{nombre}.csv""), index=False, encoding=""utf-8-sig"")#(lf)    if ""--csv"" in sys.argv:#(lf)        print(f"" CSV guardados en {carpeta_csv}"")#(lf)"),
				    rutas1 = Origen{[Name="rutas"]}[Value],
				    #"Tipo cambiado" = Table.TransformColumnTypes(rutas1,{{"distancia_km", type number}}, "en-US")
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

